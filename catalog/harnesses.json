              "claim": "Exercises initialization, opening, checkpoint, closeout, and durable resumption."
            }
          ]
        },
        "Guardrails": {
          "level": "strong",
          "evidence": [
            {
              "method": "automated",
              "path": "packages/project-harness/tests/test_project_harness.py",
              "claim": "Exercises dry-run, bounded paths, collision handling, rollback, and link rejection."
            }
          ]

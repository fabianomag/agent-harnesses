  "packages": [
    {
      "id": "project-harness",
      "displayName": "Project Harness",
      "version": "0.2.0",
      "license": "MIT",
      "artifactStatus": {
        "implementation": "implemented",
        "publication": "published"
      },
      "manifest": "packages/project-harness/harness.package.json",
      "purpose": "A small project-local lifecycle for durable context and the next action.",
      "complexity": {
        "level": "low",
        "description": "One explicit project that needs checkpoints, closeout, and reliable resumption."
      },
      "evolutionaryPosition": {
        "boundary": "single-project",
        "description": "One project is the complete coordination boundary; no cross-project state is introduced.",
        "ranking": false
      },
      "audience": {
        "primary": "project-maintainers",
        "description": "One explicit project that needs checkpoints, closeout, and reliable resumption."
      },
